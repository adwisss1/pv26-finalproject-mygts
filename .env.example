# MyGTS — Konfigurasi Supabase
# Salin file ini menjadi .env dan isi dengan data project Supabase Anda
# cp .env.example .env

# URL project Supabase (dari: Settings > API > Project URL)
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Anon key Supabase (dari: Settings > API > Project API keys > anon public)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# (Opsional) Service role key — hanya untuk operasi admin
# SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxxxxx

# (Opsional) Nama bucket Supabase Storage untuk foto inventaris
SUPABASE_BUCKET=mygts-photos
