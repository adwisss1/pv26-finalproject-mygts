/* MyGTS - Global Stylesheet */
/* Design System: Modern Minimalist */

/* Scrollbar */
QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #D4D2CD;
    border-radius: 3px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: #A8A6A2;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
}

QScrollBar:horizontal {
    background: transparent;
    height: 6px;
}
QScrollBar::handle:horizontal {
    background: #D4D2CD;
    border-radius: 3px;
    min-width: 30px;
}
QScrollBar::handle:horizontal:hover {
    background: #A8A6A2;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

/* Tooltip */
QToolTip {
    background: #1A1A1A;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 12px;
}

/* Menu */
QMenu {
    background: #ffffff;
    border: 0.5px solid #E0DDD8;
    border-radius: 8px;
    padding: 4px;
}
QMenu::item {
    padding: 8px 24px;
    font-size: 13px;
    color: #1A1A1A;
    border-radius: 4px;
}
QMenu::item:selected {
    background: #E8F0EE;
    color: #0F6E56;
}
QMenu::separator {
    height: 0.5px;
    background: #E0DDD8;
    margin: 4px 8px;
}

/* Table alternating row colors */
QTableWidget::item:alternate {
    background: #FCFBFA;
}

/* ComboBox dropdown */
QComboBox QAbstractItemView {
    background: #ffffff;
    border: 0.5px solid #E0DDD8;
    border-radius: 8px;
    selection-background-color: #E8F0EE;
    selection-color: #0F6E56;
    padding: 4px;
    outline: none;
}

/* DateEdit calendar popup */
QDateEdit QCalendarWidget {
    border: 0.5px solid #E0DDD8;
    border-radius: 8px;
}
